# ─────────────────────────────────────────────────────────────
# Sazón — variables de entorno
# Copia este archivo como .env.local y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# URL base de la API de TheMealDB (sin barra final).
# Solo se usa en el servidor (Route Handlers y Server Components).
MEALDB_API_URL=https://www.themealdb.com/api/json/v1

# Clave de la API de TheMealDB. "1" es la clave pública de desarrollo;
# si tienes una clave Premium de Patreon, colócala aquí.
# Al no llevar el prefijo NEXT_PUBLIC_, nunca se expone al navegador.
MEALDB_API_KEY=1

# Nombre visible de la aplicación (sí se expone al navegador).
NEXT_PUBLIC_APP_NAME=Sazón
